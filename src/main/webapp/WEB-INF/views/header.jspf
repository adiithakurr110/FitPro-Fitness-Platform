<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><c:out value="${pageTitle}" default="FitPro"/> | FitPro</title>
  <meta name="description" content="FitPro — Premium digital fitness coaching and intelligent progress tracking platform.">
  <link rel="stylesheet" href="${ctx}/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="${ctx}/">
      <div class="brand-emblem"><i class="fa-solid fa-bolt"></i></div>
      Fit<span>Pro</span>
    </a>

    <c:choose>
      <c:when test="${not empty sessionScope.user}">
        <ul class="nav-links">
          <li>
            <a href="${ctx}/app/dashboard" class="${pageTitle == 'Dashboard' ? 'active' : ''}">
              <i class="fa-solid fa-chart-line"></i> Dashboard
            </a>
          </li>
          <li>
            <a href="${ctx}/app/workouts" class="${pageTitle == 'Workouts' ? 'active' : ''}">
              <i class="fa-solid fa-dumbbell"></i> Workouts
            </a>
          </li>
          <c:if test="${!sessionScope.user.trainer && !sessionScope.user.admin}">
            <li>
              <a href="${ctx}/app/progress" class="${pageTitle == 'My Progress' ? 'active' : ''}">
                <i class="fa-solid fa-fire"></i> My Progress
              </a>
            </li>
          </c:if>
          <c:if test="${sessionScope.user.admin}">
            <li>
              <a href="${ctx}/app/admin" class="${pageTitle == 'Admin Portal' ? 'active' : ''}">
                <i class="fa-solid fa-user-shield"></i> Admin Portal
              </a>
            </li>
          </c:if>
        </ul>

        <div class="nav-cta-group">
          <span class="nav-role-badge ${sessionScope.user.admin ? 'admin' : (sessionScope.user.trainer ? 'trainer' : '')}">
            <c:out value="${sessionScope.user.role}"/>
          </span>
          <a class="btn outline-btn small-btn" href="${ctx}/app/logout" title="Sign out of FitPro">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign out (<c:out value="${sessionScope.user.fullName}"/>)
          </a>
          <button class="mobile-toggle" aria-label="Toggle navigation menu">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </c:when>
      <c:otherwise>
        <ul class="nav-links">
          <li><a href="${ctx}/#features">Features</a></li>
          <li><a href="${ctx}/#workouts">Workouts</a></li>
          <li><a href="${ctx}/#how-it-works">How It Works</a></li>
          <li><a href="${ctx}/#about">About</a></li>
        </ul>
        <div class="nav-cta-group">
          <a class="btn outline-btn small-btn" href="${ctx}/login">Sign In</a>
          <a class="btn primary-btn small-btn" href="${ctx}/register">Get Started</a>
          <button class="mobile-toggle" aria-label="Toggle navigation menu">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </c:otherwise>
    </c:choose>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer">
    <c:choose>
      <c:when test="${not empty sessionScope.user}">
        <a href="${ctx}/app/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
        <a href="${ctx}/app/workouts"><i class="fa-solid fa-dumbbell"></i> Workouts</a>
        <c:if test="${!sessionScope.user.trainer && !sessionScope.user.admin}">
          <a href="${ctx}/app/progress"><i class="fa-solid fa-fire"></i> My Progress</a>
        </c:if>
        <c:if test="${sessionScope.user.admin}">
          <a href="${ctx}/app/admin"><i class="fa-solid fa-user-shield"></i> Admin Portal</a>
        </c:if>
        <a href="${ctx}/app/logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Sign out</a>
      </c:when>
      <c:otherwise>
        <a href="${ctx}/#features">Features</a>
        <a href="${ctx}/#workouts">Workouts</a>
        <a href="${ctx}/#how-it-works">How It Works</a>
        <a href="${ctx}/login">Sign In</a>
        <a href="${ctx}/register">Get Started</a>
      </c:otherwise>
    </c:choose>
  </div>
</header>

<main class="container">
  <c:if test="${not empty error}">
    <div class="alert error" role="alert">
      <i class="fa-solid fa-circle-exclamation"></i>
      <span><c:out value="${error}"/></span>
    </div>
  </c:if>
  <c:if test="${not empty success}">
    <div class="alert success" role="alert">
      <i class="fa-solid fa-circle-check"></i>
      <span><c:out value="${success}"/></span>
    </div>
  </c:if>
