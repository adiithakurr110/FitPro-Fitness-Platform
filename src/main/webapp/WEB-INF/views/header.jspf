<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}" default="FitPro"/> | FitPro</title>
  <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="${ctx}/">Fit<span>Pro</span></a>
  <c:if test="${not empty sessionScope.user}">
    <nav>
      <a href="${ctx}/app/dashboard">Dashboard</a>
      <a href="${ctx}/app/workouts">Workouts</a>
      <c:if test="${!sessionScope.user.trainer}"><a href="${ctx}/app/progress">My Progress</a></c:if>
      <a class="logout" href="${ctx}/app/logout">Logout (<c:out value="${sessionScope.user.fullName}"/>)</a>
    </nav>
  </c:if>
</header>
<main class="container">
  <c:if test="${not empty error}"><div class="alert error"><c:out value="${error}"/></div></c:if>
  <c:if test="${not empty success}"><div class="alert success"><c:out value="${success}"/></div></c:if>
